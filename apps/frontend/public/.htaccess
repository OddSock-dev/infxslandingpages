# Apache configuration for Nuxt SSG static site
# Upload the contents of .output/public/ to your cPanel document root
# This file is automatically copied there by nuxt generate

Options -MultiViews -Indexes
RewriteEngine On
RewriteBase /

# Serve _nuxt/ static assets directly (hashed JS/CSS bundles)
RewriteRule ^_nuxt/ - [L]

# Serve existing files and directories directly (HTML, images, favicon, robots.txt)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA fallback: route unknown paths to index.html for client-side routing
# (handles any route not pre-rendered at build time)
RewriteRule ^ /index.html [L]

# -----------------------------------------------------------------------
# Security headers
# -----------------------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"

    # Allow API requests to the Laravel backend (CORS is handled server-side)
    Header always unset X-Powered-By
</IfModule>

# -----------------------------------------------------------------------
# Cache control — long TTL for hashed assets, no-cache for HTML
# -----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    # HTML — always revalidate so users get fresh content
    ExpiresByType text/html "access plus 0 seconds"

    # Hashed JS/CSS bundles — cache forever (filename changes on rebuild)
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"

    # Fonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    # Images
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# -----------------------------------------------------------------------
# Compression — reduce transfer size
# -----------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript
    AddOutputFilterByType DEFLATE application/json text/xml image/svg+xml
    AddOutputFilterByType DEFLATE font/woff2 font/woff
</IfModule>
